# Port de l'API HTTP (process web)
PORT=3000

# Chemin du fichier SQLite partage entre le worker et l'API
DB_PATH=./data/coteradar.sqlite

# Frequence de scraping en minutes (process worker). L'API la lit aussi : une
# cote qui n'a pas ete rafraichie depuis 3 cycles est consideree comme retiree
# par le bookmaker et n'est plus affichee.
POLL_INTERVAL_MINUTES=5

# Frequence, en minutes, du cycle qui recupere tous les marches (buts, buteurs,
# mi-temps, totaux...) des matchs de foot, de tennis et de basket des 48
# prochaines heures (process worker).
# L'API la lit aussi, comme POLL_INTERVAL_MINUTES.
MARKETS_INTERVAL_MINUTES=15

# Duree, en secondes, pendant laquelle l'API reutilise la reponse de la page
# des value bets (/api/value-bets) : elle lit les cotes de tous les matchs a
# venir et ne change qu'au rythme des cycles du worker (process web).
# 0 desactive le cache.
VALUE_BETS_CACHE_SECONDS=30

# Duree, en secondes, pendant laquelle l'API reutilise les matchs de la page
# Freebets et la reponse d'un compte (/api/freebets/conversions) : meme
# raison, et le calcul est plus lent encore. Il tourne dans un thread a part
# (process web). 0 desactive le cache.
FREEBETS_CACHE_SECONDS=30

# Alertes Discord (process worker, src/alerts/gems.ts) : le webhook du salon
# ou arrivent les gems ; pas d'alertes sans. En production, le deploiement
# l'ecrit ici depuis le secret GitHub du meme nom : ne pas le modifier a la
# main sur le VPS.
DISCORD_WEBHOOK_URL=

# L'adresse publique du site, pour les liens des alertes. En production, le
# deploiement l'ecrit ici.
PUBLIC_URL=http://localhost:3000

# Les comptes (src/auth/) : leur propre fichier SQLite, a sauvegarder (ils ne
# se reconstruisent pas, contrairement aux cotes). Voir docs/db-audit.md.
AUTH_DB_PATH=./data/auth.sqlite

# Les emails des comptes (confirmation, mot de passe oublie). Sans SMTP_HOST et
# SMTP_FROM, les emails sont ecrits dans les logs de l'API (developpement) ;
# en production (NODE_ENV=production) l'API refuse de demarrer sans eux. En
# production, le deploiement les ecrit ici depuis les secrets GitHub du meme
# nom : ne pas les modifier a la main sur le VPS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CoteRadar <no-reply@example.com>

# Le site de test (staging) a son propre .env sur le VPS, voir
# deploy/staging/.env.staging.example : autre port, autres bases, cycles plus
# espaces, pas de DISCORD_WEBHOOK_URL.

# Derriere un reverse proxy (Caddy, voir deploy/Caddyfile) : TRUST_PROXY=1 pour
# lire l'adresse du visiteur dans X-Forwarded-For, et HOST=127.0.0.1 pour que
# seul le proxy atteigne l'API. PUBLIC_URL en https:// (cookies Secure, HSTS).
# Ne pas les mettre sans proxy : l'adresse du visiteur serait falsifiable.
# TRUST_PROXY=1
# HOST=127.0.0.1
