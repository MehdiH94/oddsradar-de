# /etc/caddy/Caddyfile: the HTTPS reverse proxy in front of the API
# (oddsradar-web, on 127.0.0.1:3000). Caddy gets and renews the Let's Encrypt
# certificates by itself: the names must point to the VPS (A records only, no
# AAAA to another host) and ports 80 and 443 be open. Then:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# And in /opt/oddsradar/.env: TRUST_PROXY=1, HOST=127.0.0.1 and
# PUBLIC_URL=https://odds-blitzer.de (README, "Comptes et HTTPS").
odds-blitzer.de {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# The other names lead to the site's own, the path and query kept: www, and the
# server's sslip.io name, the site's address before it had its domain (links
# of old alerts and emails).
www.odds-blitzer.de, 141-95-86-176.sslip.io {
	redir https://odds-blitzer.de{uri} permanent
}

# The staging site (deploy/staging/Caddyfile.snippet).
import /etc/caddy/staging.caddy
