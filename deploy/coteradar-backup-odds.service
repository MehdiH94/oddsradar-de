[Unit]
Description=CoteRadar odds database backup

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/coteradar
# The odds are rebuilt by the worker, but the players' stats, their signals and
# the alerts sent are not: a copy every week, kept 28 days (4 copies).
ExecStart=/opt/coteradar/deploy/backup-db.sh data/coteradar.sqlite odds 28
