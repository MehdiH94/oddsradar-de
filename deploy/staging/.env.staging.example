# /opt/oddsradar-staging/.env : le .env du site de test (README, "Environnement
# de test"). Même format que .env.example. Le déploiement y écrit lui-même
# PUBLIC_URL et les SMTP_* ; le reste se règle à la main, une fois.

PORT=3001
HOST=127.0.0.1
TRUST_PROXY=1

# Ses propres bases : jamais celles de la production. DB_PATH peut démarrer
# d'une copie de la base des cotes (sqlite3 ... ".backup ..."), jamais de
# auth.sqlite.
DB_PATH=./data/coteradar.sqlite
AUTH_DB_PATH=./data/auth.sqlite

# Le staging scrape depuis la même IP que la production : un cycle toutes les
# 45 minutes plutôt que toutes les 5, pour ne pas doubler le trafic vers les
# bookmakers (Genybet a déjà bloqué le serveur).
POLL_INTERVAL_MINUTES=45
MARKETS_INTERVAL_MINUTES=60

# Pas de DISCORD_WEBHOOK_URL : le staging ne doit pas dupliquer les alertes de
# la production.
