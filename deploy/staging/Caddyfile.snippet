# Bloc à ajouter à /etc/caddy/Caddyfile, à côté de celui du site de production
# (deploy/Caddyfile) : le site de test, servi par oddsradar-staging-web sur
# 127.0.0.1:3001. Le DNS de staging.cote-radar.fr doit pointer vers le VPS.
# Puis : sudo systemctl reload caddy
staging.cote-radar.fr {
	encode zstd gzip
	# Le site de test ne doit pas apparaître dans les moteurs de recherche.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:3001
}
