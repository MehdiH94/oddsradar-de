[Unit]
Description=CoteRadar staging scraping worker
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/coteradar-staging
EnvironmentFile=/opt/coteradar-staging/.env
ExecStart=/usr/bin/node dist/worker/index.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
