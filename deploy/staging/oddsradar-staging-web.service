[Unit]
Description=OddsRadar staging API + web
After=network.target

[Service]
Type=simple
User=oddsradar
Group=oddsradar
WorkingDirectory=/opt/oddsradar-staging
# Production mode on purpose: staging must behave like production (secure
# cookies, HSTS, mail settings required).
Environment=NODE_ENV=production
EnvironmentFile=/opt/oddsradar-staging/.env
ExecStart=/usr/bin/node dist/api/index.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
