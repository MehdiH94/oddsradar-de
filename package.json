{
  "name": "coteradar",
  "version": "0.1.0",
  "description": "Comparateur de cotes en direct entre bookmakers francais (Winamax, Betclic, Vbet, CircusBet, DAZN Bet, NetBet, Genybet, Unibet, Betsson, PMU).",
  "private": true,
  "scripts": {
    "build": "tsc",
    "worker": "ts-node src/worker/index.ts",
    "api": "ts-node src/api/index.ts",
    "create-admin": "ts-node src/auth/createAdmin.ts",
    "test": "vitest run",
    "icons": "node scripts/fetch-bookmaker-icons.mjs",
    "e2e": "npm run build --prefix web && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=23.4.0"
  }
}
